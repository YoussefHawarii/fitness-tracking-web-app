// Prisma schema for the Calorie & Weight Tracking Web App
// See /specs/001-calorie-weight-tracking/data-model.md for the logical model this maps to.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum FoodSourceType {
  OPEN_FOOD_FACTS
  USDA
  LOCAL
  CANONICAL
}

enum MealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
}

enum SportType {
  FOOTBALL
  SWIMMING
  PADEL
  BASKETBALL
  GYM_WEIGHTS
  RUNNING
  TENNIS
  OTHER
}

enum Units {
  KG
  LB
}

enum Appearance {
  LIGHT
  DARK
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  CORE
}

enum WorkoutExerciseType {
  // Chest
  BARBELL_BENCH_PRESS
  INCLINE_BARBELL_BENCH_PRESS
  DUMBBELL_BENCH_PRESS
  INCLINE_DUMBBELL_PRESS
  MACHINE_CHEST_PRESS
  INCLINE_MACHINE_CHEST_PRESS
  PEC_DECK_FLY
  CABLE_CROSSOVER
  PUSH_UPS
  CHEST_DIPS
  // Back
  LAT_PULLDOWN
  SEATED_CABLE_ROW
  BENT_OVER_BARBELL_ROW
  ONE_ARM_DUMBBELL_ROW
  T_BAR_ROW
  PULL_UPS
  CHIN_UPS
  STRAIGHT_ARM_PULLDOWN
  DEADLIFT
  // Shoulders
  BARBELL_OVERHEAD_PRESS
  DUMBBELL_SHOULDER_PRESS
  MACHINE_SHOULDER_PRESS
  LATERAL_RAISE
  FRONT_RAISE
  REAR_DELT_FLY
  CABLE_LATERAL_RAISE
  ARNOLD_PRESS
  SHRUGS
  // Biceps
  BARBELL_CURL
  DUMBBELL_CURL
  HAMMER_CURL
  PREACHER_CURL
  CONCENTRATION_CURL
  CABLE_CURL
  INCLINE_DUMBBELL_CURL
  // Triceps
  CABLE_TRICEPS_PUSHDOWN
  OVERHEAD_TRICEPS_EXTENSION
  SKULL_CRUSHERS
  CLOSE_GRIP_BENCH_PRESS
  TRICEPS_DIPS
  ROPE_PUSHDOWN
  // Legs
  BARBELL_SQUAT
  LEG_PRESS
  LEG_EXTENSION
  LEG_CURL
  ROMANIAN_DEADLIFT
  LUNGES
  BULGARIAN_SPLIT_SQUAT
  HIP_THRUST
  CALF_RAISE
  // Abs/Core
  CRUNCHES
  SIT_UPS
  PLANK
  HANGING_LEG_RAISE
  CABLE_CRUNCH
  RUSSIAN_TWIST
  AB_WHEEL_ROLLOUT
  LEG_RAISE
}

model User {
  id                    String      @id @default(uuid())
  username              String?     @unique
  email                 String      @unique
  emailVerified         Boolean     @default(false)
  passwordHash          String?
  googleSubjectId       String?     @unique
  timezone              String
  createdAt             DateTime    @default(now())

  // Account/Settings (specs/008-sidebar-profile-account)
  displayName           String?
  avatarUrl             String?
  avatarPublicId        String?
  unitsPreference       Units       @default(KG)
  languagePreference    String      @default("en")
  appearancePreference  Appearance?

  baseline         UserBaseline?
  localFoodItems   LocalFoodItem[]
  foodLogEntries   FoodLogEntry[]
  exerciseLogs     ExerciseLogEntry[]
  weighIns         WeighIn[]
  workoutSessions  WorkoutSession[]
  refreshTokens    RefreshToken[]
  otpCodes         OtpCode[]

  @@map("users")
}

model OtpCode {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String
  purpose       OtpPurpose
  expiresAt     DateTime
  attemptCount  Int        @default(0)
  lastSentAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@unique([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model UserBaseline {
  userId           String        @id
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age              Int
  sex              Sex
  heightCm         Decimal
  currentWeightKg  Decimal
  goalWeightKg     Decimal
  activityLevel    ActivityLevel
  bmr              Decimal
  tdee             Decimal
  updatedAt        DateTime      @updatedAt

  @@map("user_baselines")
}

model LocalFoodItem {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  caloriesPer100g  Decimal
  proteinPer100g   Decimal?
  carbsPer100g     Decimal?
  fatPer100g       Decimal?
  createdAt        DateTime @default(now())

  foodLogEntries   FoodLogEntry[]

  @@map("local_food_items")
}

// Small, curated, bilingual (English + Arabic, including common Egyptian dialect
// terms) canonical foods table — searched before falling back to USDA's live API,
// so a generic query like "chicken breast" resolves to one representative item
// instead of USDA's many near-duplicate branded/prepared results.
// See docs/food-log-input-modes-diagnosis.md §3.2 (Option A).
model CanonicalFood {
  id               String   @id @default(uuid())
  nameEn           String   @unique
  nameAr           String
  aliasesEn        String[] @default([])
  aliasesAr        String[] @default([])
  caloriesPer100g  Decimal
  proteinPer100g   Decimal?
  carbsPer100g     Decimal?
  fatPer100g       Decimal?
  createdAt        DateTime @default(now())

  foodLogEntries   FoodLogEntry[]

  @@map("canonical_foods")
}

model FoodLogEntry {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType        FoodSourceType
  sourceRef         String
  name              String         @default("")
  localFoodItemId   String?
  localFoodItem     LocalFoodItem? @relation(fields: [localFoodItemId], references: [id], onDelete: SetNull)
  canonicalFoodId   String?
  canonicalFood     CanonicalFood? @relation(fields: [canonicalFoodId], references: [id], onDelete: SetNull)
  grams             Decimal
  caloriesComputed  Decimal
  proteinComputed   Decimal?
  carbsComputed     Decimal?
  fatComputed       Decimal?
  mealCategory      MealCategory
  loggedAtUtc       DateTime

  @@index([userId, loggedAtUtc])
  @@map("food_log_entries")
}

model ExerciseLogEntry {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportType        SportType
  customSportName  String?
  durationMinutes  Int
  caloriesBurned   Decimal
  loggedForDate    DateTime  @db.Date
  createdAt        DateTime  @default(now())

  @@index([userId, loggedForDate])
  @@map("exercise_log_entries")
}

model WeighIn {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg       Decimal
  loggedForDate  DateTime @db.Date

  @@index([userId, loggedForDate])
  @@map("weigh_ins")
}

model WorkoutSession {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroups   MuscleGroup[]
  loggedForDate  DateTime          @db.Date
  createdAt      DateTime          @default(now())
  exercises      WorkoutExercise[]

  @@index([userId, loggedForDate])
  @@map("workout_sessions")
}

model WorkoutExercise {
  id                String              @id @default(uuid())
  workoutSessionId  String
  workoutSession    WorkoutSession      @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseType      WorkoutExerciseType
  order             Int
  sets              WorkoutSet[]

  @@index([workoutSessionId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                 String          @id @default(uuid())
  workoutExerciseId  String
  workoutExercise    WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber          Int
  reps               Int
  weightKg           Decimal?

  @@index([workoutExerciseId])
  @@map("workout_sets")
}
