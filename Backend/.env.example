# Copy to .env and fill in real values. Never commit the real .env file.

# Neon Postgres connection string (free tier) — see docs/technical-decisions.md
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secrets used to sign/verify JWTs (HS256) — one for access tokens, one for
# refresh tokens, so either can be rotated independently (e.g. a leaked
# refresh secret can be rotated without invalidating every live access
# token). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Run it twice — once for each var.
ACCESS_TOKEN="change-me"
REFRESH_TOKEN="change-me"

# USDA FoodData Central free API key — https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY="change-me"

# Google OAuth client ID — only ID-token verification is used server-side
# (google-auth-library's OAuth2Client), so no client secret is needed here.
GOOGLE_CLIENT_ID="change-me"

PORT=3000

# Deployed frontend origin, for CORS (see src/main.ts). Falls back to the
# local Vite dev server origin when unset.
FRONTEND_ORIGIN="http://localhost:5173"

# SMTP credentials used by Nodemailer to send OTP + welcome emails.
# For Gmail: use an App Password (not your regular password) — generate one at
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="change-me"
SMTP_PASS="change-me"
SMTP_FROM="Fitness Tracker <change-me>"

# Cloudinary credentials used to store account avatar photos (signed direct
# uploads from the browser — see specs/008-sidebar-profile-account/research.md §1)
CLOUDINARY_CLOUD_NAME="change-me"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"

# Optional — inbox for the Settings > Support feedback form. Falls back to
# SMTP_FROM's address when unset.
SUPPORT_EMAIL="change-me"
